ANTHROPIC_URI_ENDPOINT=https://ia-report-agent-resource.services.ai.azure.com/anthropic/v1/messages
ANTHROPIC_API_KEY=<my_api_key>
ANTHROPIC_MODEL=claude-sonnet-4-5

# API defaults are suitable for local development.
# API_DATA_ROOT=/absolute/path/to/ia_audit_report/data
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_RUN_WORKERS=1

# Local zero-config default:
# DATABASE_URL=sqlite+pysqlite:////absolute/path/backend/.runtime/audit.db
# Production:
# DATABASE_URL=postgresql+psycopg://audit_user:password@localhost:5432/audit_report
# PROJECT_STORAGE_ROOT=/absolute/path/to/project-storage
RAW_UPLOAD_RETENTION_DAYS=7
UPLOAD_MAX_FILES=500
UPLOAD_MAX_BYTES=1073741824

# Docker Compose overrides these two values inside the backend container:
# DATABASE_URL=postgresql+psycopg://audit_user:audit_poc_password@postgres:5432/audit_report
# PROJECT_STORAGE_ROOT=/var/lib/ia-audit-report/projects
